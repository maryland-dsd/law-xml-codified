      <annotation app="2026-11-23" doc="Maryland Register, Volume 53, Issue 23" eff="2026-11-23" path="regulations|final|26-082-F" target-path="37|01|01" type="History" display="false"/>
    </annotations>
  </section>
  <section>
    <prefix>Regulation</prefix>
    <num>.03</num>
    <heading>Adoption of Regulations.</heading>
    <text>The Secretary shall propose and adopt all new, amended, and repealed regulations for regular promulgation and emergency action as prescribed in the Administrative Procedure Act, Annotated Code of Maryland.</text>
